            "default": 0,
            "title": "Transaction Count",
            "type": "integer"
          },
          "total_spend": {
            "default": 0.0,
            "title": "Total Spend",
            "type": "number"
          },
          "by_category": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "By Category",
            "type": "object"
          }
        },
        "title": "SpendOverviewReport",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_brex-connector_chat"
    },
